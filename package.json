{
	"name": "taxicity-web",
	"version": "2.2.0",
	"packageManager": "pnpm@10.23.0",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "turbo dev",
		"build": "turbo build",
		"build:apps": "turbo build:apps --filter=mobile*",
		"start": "turbo start",
		"lint": "turbo lint",
		"check": "turbo check",
		"db:generate": "pnpm --filter @taxiciti/database generate",
		"docker:build-user": "docker build --platform linux/amd64 -f apps/user/Dockerfile -t mmpotulo28/taxiciti-user:latest .",
		"docker:build-driver": "docker build --platform linux/amd64 -f apps/driver/Dockerfile -t mmpotulo28/taxiciti-driver:latest .",
		"docker:push": "pnpm --filter apps/user docker:push && pnpm --filter apps/driver docker:push",
		"test:e2e": "playwright test",
		"cli": "node --loader ts-node/esm scripts/manage.ts"
	},
	"prisma": {
		"seed": "node --loader ts-node/esm prisma/seed.ts"
	},
