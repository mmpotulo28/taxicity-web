		"/search": {
			"get": {
				"tags": ["Search"],
				"summary": "Search across multiple entities",
				"parameters": [
					{
						"name": "query",
						"in": "query",
						"required": true,
						"schema": {
							"type": "string",
							"minLength": 1,
							"maxLength": 200
						},
						"description": "Search query string"
					},
					{
						"name": "type",
						"in": "query",
						"schema": {
							"type": "string",
							"enum": ["all", "taxis", "drivers", "routes", "ranks", "users"],
							"default": "all"
						},
						"description": "Type of entities to search"
					},
					{
						"name": "filters",
						"in": "query",
						"schema": {
							"type": "string"
						},
						"description": "JSON string of additional filters"
					}
				],
				"responses": {
					"200": {
						"description": "Search results",
						"content": {
							"application/json": {
								"schema": {
									"type": "object",
									"properties": {
										"query": {
											"type": "string"
										},
										"type": {
											"type": "string"
										},
										"results": {
											"type": "object",
											"properties": {
												"taxis": {
													"type": "array",
													"items": {
														"$ref": "#/components/schemas/Taxi"
													}
												},
												"drivers": {
													"type": "array",
													"items": {
														"$ref": "#/components/schemas/Driver"
													}
												},
												"routes": {
													"type": "array",
													"items": {
														"$ref": "#/components/schemas/Route"
													}
												},
												"ranks": {
													"type": "array",
													"items": {
														"$ref": "#/components/schemas/Rank"
													}
												}
											}
										},
										"total": {
											"type": "integer"
										},
										"pagination": {
											"type": "object",
											"properties": {
												"page": {
													"type": "integer"
												},
												"limit": {
													"type": "integer"
												},
												"hasMore": {
													"type": "boolean"
												}
											}
										}
									}
								}
							}
						}
					}
				}
			}
		}
