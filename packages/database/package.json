{
	"name": "@taxiciti/database",
	"version": "0.0.1",
	"main": "dist/index.cjs",
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		},
		"./types": "./types.ts"
	},
	"type": "module",
	"scripts": {
		"postinstall": "pnpm generate",
		"generate": "prisma generate",
		"migrate:deploy": "prisma migrate deploy",
		"db:push": "prisma db push",
		"studio": "prisma studio",
		"check": "tsc --noEmit",
		"db:seed": "node prisma/seed.ts",
		"build": "tsup index.ts --format cjs,esm --clean && tsc -p tsconfig.json --declaration --emitDeclarationOnly"
	},
	"dependencies": {
		"@clerk/nextjs": "^6.37.3",
		"@prisma/adapter-pg": "^7.3.0",
		"@prisma/client": "^7.3.0",
		"@prisma/extension-accelerate": "^2.0.2",
		"@upstash/redis": "^1.36.2"
	},
	"devDependencies": {
		"@swc/core": "^1.15.11",
		"@taxiciti/configs": "workspace:*",
		"@types/node": "20.5.7",
		"dotenv": "^17.2.4",
		"prisma": "^7.3.0",
		"ts-node": "^10.9.2",
		"tsup": "^8.5.1",
		"typescript": "5.6.3"
	}
}
