{
	"$schema": "https://turbo.build/schema.json",
	"ui": "tui",
	"globalPassThroughEnv": [
		"API_URL",
		"CI",
		"CLERK_JWT_PUBLIC_KEY",
		"CORS_ORIGINS",
		"SENTRY_AUTH_TOKEN",
		"CLERK_SECRET_KEY",
		"DATABASE_URL",
		"DATABASE_URL_UNPOOLED",
		"EXPO_PUBLIC_DRIVER_APP_URL",
		"EXPO_PUBLIC_NEWRELIC_ANDROID_APP_TOKEN",
		"EXPO_PUBLIC_NEWRELIC_IOS_APP_TOKEN",
		"EXPO_PUBLIC_USER_APP_URL",
		"GOOGLE_MAPS_API_KEY",
		"INTERNAL_PROXY_SECRET",
		"JWT_PUBLIC_KEY",
		"JWT_SECRET",
		"NEXT_PUBLIC_API_URL",
		"POSTGRES_URL",
		"POSTGRES_URL_NO_SSL",
		"POSTGRES_PRISMA_URL",
		"POSTGRES_HOST",
		"POSTGRES_DATABASE",
		"POSTGRES_PASSWORD",
		"NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID",
		"NEXT_RUNTIME",
		"NODE_ENV",
		"PORT",
		"PGHOST",
		"PGHOST_UNPOOLED",
		"PGDATABASE",
		"PGUSER",
		"PGPASSWORD",
		"NEON_PROJECT_ID",
		"UPLOAD_MAX_FILE_BYTES",
		"UPSTASH_REDIS_URL",
		"WEBSOCKET_URL",
		"WS_INTERNAL_API_KEY",
		"DATABASE_URL_UNPOOLED",
		"POSTGRES_URL",
		"POSTGRES_URL_NO_SSL",
		"POSTGRES_URL_NON_POOLING",
		"POSTGRES_PRISMA_URL",
		"POSTGRES_HOST",
		"POSTGRES_DATABASE",
		"POSTGRES_USER",
		"POSTGRES_PASSWORD",
		"PGHOST",
		"PGHOST_UNPOOLED",
		"PGDATABASE",
		"PGUSER",
		"PGPASSWORD",
		"NEON_PROJECT_ID",
		"BLOB_READ_WRITE_TOKEN",
		"NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY",
		"NEXT_PUBLIC_GOOGLE_MAPS_API_KEY",
		"VERCEL_OIDC_TOKEN",
		"PUSHER_APP_ID",
		"PUSHER_KEY",
		"PUSHER_SECRET",
		"PUSHER_CLUSTER",
		"NEXT_PUBLIC_PUSHER_KEY",
		"NEXT_PUBLIC_PUSHER_CLUSTER",
		"NEXT_PUBLIC_FARO_URL",
		"UPSTASH_REDIS_REST_URL",
		"UPSTASH_REDIS_REST_TOKEN",
		"KV_REST_API_URL",
		"KV_REST_API_TOKEN",
		"REDIS_URL",
		"KV_REST_API_READ_ONLY_TOKEN",
		"KV_URL"
	],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": [".next/**", "!.next/cache/**", "dist/**"]
		},
		"build:apps": {
			"cache": false
		},
		"lint": {
			"dependsOn": ["^lint"]
		},
		"check": {
			"dependsOn": ["^check"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"start": {
			"cache": false,
			"persistent": true
		},
		"generate": {
			"cache": false
		}
	}
}
