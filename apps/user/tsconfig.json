{
  "extends": "@taxyciti/configs/tsconfig",
  "compilerOptions": {
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "plugins": [
      {
        "name": "next"
      }
    ],
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "../../packages/ui/hero.ts",
    "../../packages/ui/src/hooks/useNotifications.ts",
    "../../packages/ui/src/components/NotificationBell.tsx"
  ],
  "exclude": [
    "node_modules"
  ]
}