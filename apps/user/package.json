{
	"name": "user-app",
	"version": "0.0.1",
	"type": "module",
	"private": true,
	"scripts": {
		"predev": "pnpm --filter @taxiciti/utils build",
		"dev": "next dev --turbopack -p 3000",
		"prebuild": "pnpm --filter @taxiciti/utils build",
		"build": "next build",
		"start": "next start",
		"lint": "eslint . --fix",
		"check": "eslint . --fix && tsc --noEmit",
		"docker:build": "docker build --platform linux/amd64 -f apps/user/Dockerfile -t mmpotulo28/taxiciti-user:latest .",
		"docker:push": "docker push mmpotulo28/taxiciti-user:latest"
	},
	"dependencies": {
		"@clerk/nextjs": "^6.39.3",
		"@heroui/react": "^2.8.7",
		"@react-google-maps/api": "^2.20.8",
		"@sentry/nextjs": "^10.40.0",
		"@tanstack/react-query": "^5.90.16",
		"@taxiciti/database": "workspace:*",
		"@taxiciti/ui": "workspace:*",
		"@taxiciti/utils": "workspace:*",
		"@upstash/ratelimit": "^2.0.8",
		"@upstash/redis": "^1.36.2",
		"@vercel/blob": "^2.0.0",
		"axios": "^1.15.2",
		"framer-motion": "^11.18.2",
		"mapbox-gl": "^3.18.1",
		"next": "^16.2.3",
		"pusher-js": "^8.4.0",
		"react": "19.2.3",
		"react-dom": "19.2.3",
		"react-map-gl": "^8.1.0",
		"socket.io-client": "^4.7.4",
		"swr": "^2.3.8",
		"zod": "^4.3.5"
	},
	"devDependencies": {
		"@react-types/shared": "^3.32.1",
		"@taxiciti/configs": "workspace:*",
		"@types/google.maps": "^3.58.1",
		"@types/node": "20.5.7",
		"@types/react": "19.2.8",
		"@types/react-dom": "^19.2.3",
		"postcss": "8.5.6",
		"tailwindcss": "4.1.11",
		"typescript": "5.6.3"
	}
}
