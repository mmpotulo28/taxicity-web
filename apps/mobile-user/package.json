{
	"name": "mobile-user",
	"version": "1.0.0",
	"main": "index.ts",
	"scripts": {
		"dev": "pnpm start",
		"start": "dotenv -e ../../.env -- expo start -p 3005",
		"android": "dotenv -e ../../.env -- expo run:android",
		"ios": "dotenv -e ../../.env -- expo run:ios",
		"web": "dotenv -e ../../.env -- expo start --web",
		"build:apps": "eas build --platform android --non-interactive",
		"type-check": "tsc --noEmit"
	},
	"dependencies": {
		"@babel/runtime": "^7.28.6",
		"@expo/vector-icons": "^15.0.3",
		"@sentry/react-native": "^7.2.0",
		"expo": "~54.0.33",
		"expo-constants": "~18.0.13",
		"expo-dev-client": "~6.0.20",
		"expo-insights": "~0.10.8",
		"expo-location": "^19.0.8",
		"expo-splash-screen": "^31.0.13",
		"expo-status-bar": "~3.0.9",
		"expo-system-ui": "~6.0.9",
		"expo-updates": "~29.0.16",
		"newrelic-react-native-agent": "^1.5.12",
		"react": "19.1.0",
		"react-native": "0.81.5",
		"react-native-safe-area-context": "^5.6.2",
		"react-native-webview": "^13.15.0"
	},
	"devDependencies": {
		"@babel/core": "^7.20.0",
		"@types/react": "~19.1.17",
		"typescript": "~5.9.3"
	},
	"private": true
