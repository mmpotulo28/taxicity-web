// TaxiCity Prisma Schema
// PostgreSQL Database

generator client {
  provider = "prisma-client-js"
  output   = "./src/lib/prisma/generated"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// USER MODELS
model User {
  id                String             @id @default(uuid())
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  email             String             @unique
  phone             String?
  passwordHash      String
  fullName          String
  profileImage      String?
  deviceToken       String?
  trips             Trip[]
  tripRatings       TripRating[]
  savedLocations    SavedLocation[]
  emergencyContacts EmergencyContact[]
  favoriteDrivers   FavoriteDriver[]
  preferredRoutes   RoutePreference[]
  lastKnownLocation UserLocation?

  @@map("users")
}

model UserLocation {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lat       Float
  lng       Float
  accuracy  Float?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String   @unique

  @@map("user_locations")
}

model SavedLocation {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  name      String
  address   String
  lat       Float
  lng       Float
  type      String // home, work, favorite, etc.
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  @@map("saved_locations")
}

model EmergencyContact {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  name      String
  phone     String
  relation  String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  @@map("emergency_contacts")
}

// TAXI AND DRIVER MODELS
model Driver {
  id               String           @id @default(uuid())
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  firstName        String
  lastName         String
  fullName         String?
  phone            String           @unique
  email            String?          @unique
  profileImage     String?
  licenseNumber    String           @unique
  licenseExpiry    DateTime
  dateOfBirth      DateTime?
  address          String?
  status           DriverStatus     @default(ACTIVE)
  verificationDate DateTime?
  taxis            Taxi[]
  tripRatings      TripRating[]
  favoriteOfUsers  FavoriteDriver[]

  @@map("drivers")
}

model Taxi {
  id              String         @id @default(uuid())
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  licensePlate    String         @unique
  model           String
  make            String
  year            Int?
  color           String
  capacity        Int
  status          TaxiStatus     @default(AVAILABLE)
  registrationDoc String? // URL to registration document
  insuranceDoc    String? // URL to insurance document
  driver          Driver         @relation(fields: [driverId], references: [id])
  driverId        String
  taxiRanks       TaxiRank[]
  routes          TaxiOnRoute[]
  trips           Trip[]
  currentLocation TaxiLocation?  @relation("current_location")
  locationHistory TaxiLocation[] @relation("history")
  maintenanceLog  Maintenance[]

  @@map("taxis")
}

model TaxiLocation {
  id            String   @id @default(uuid())
  createdAt     DateTime @default(now())
  lat           Float
  lng           Float
  heading       Float?
  speed         Float?
  taxi          Taxi?    @relation("current_location", fields: [taxiId], references: [id], onDelete: SetNull)
  taxiId        String?  @unique // Added @unique for the one-to-one relation
  taxiHistory   Taxi?    @relation("history", fields: [taxiHistoryId], references: [id], onDelete: SetNull)
  taxiHistoryId String?

  @@index([taxiHistoryId, createdAt])
  @@map("taxi_locations")
}

model Maintenance {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  date        DateTime
  description String
  cost        Decimal  @db.Decimal(10, 2)
  odometer    Int?
  type        String // routine, repair, etc.
  taxi        Taxi     @relation(fields: [taxiId], references: [id], onDelete: Cascade)
  taxiId      String

  @@map("maintenance_logs")
}

model FavoriteDriver {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  driver    Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  driverId  String

  @@unique([userId, driverId])
  @@map("favorite_drivers")
}

// RANK AND ROUTE MODELS
model Rank {
  id             String     @id @default(uuid())
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  name           String
  address        String
  city           String
  province       String
  region         String
  description    String?
  lat            Float
  lng            Float
  phone          String?
  operatingHours String?
  capacity       Int?
  isActive       Boolean    @default(true)
  image          String? // URL to image of the rank
  sourceRoutes   Route[]    @relation("source_rank")
  destRoutes     Route[]    @relation("destination_rank")
  taxiRanks      TaxiRank[]
  trips          Trip[]

  @@map("ranks")
}

model Route {
  id                String            @id @default(uuid())
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  name              String
  description       String?
  distance          Float // in km
  baseFare          Decimal           @db.Decimal(10, 2)
  estimatedDuration Int // in minutes
  sourceRank        Rank              @relation("source_rank", fields: [sourceRankId], references: [id])
  sourceRankId      String
  destRank          Rank?             @relation("destination_rank", fields: [destRankId], references: [id])
  destRankId        String?
  status            RouteStatus       @default(ACTIVE)
  taxis             TaxiOnRoute[]
  trips             Trip[]
  userPreferences   RoutePreference[]

  @@map("routes")
}

model RoutePreference {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  frequency Int      @default(0) // How often user takes this route
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  route     Route    @relation(fields: [routeId], references: [id], onDelete: Cascade)
  routeId   String

  @@unique([userId, routeId])
  @@map("route_preferences")
}

model TaxiRank {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  taxi      Taxi     @relation(fields: [taxiId], references: [id], onDelete: Cascade)
  taxiId    String
  rank      Rank     @relation(fields: [rankId], references: [id], onDelete: Cascade)
  rankId    String
  isHome    Boolean  @default(false) // Is this the taxi's home rank?

  @@unique([taxiId, rankId])
  @@map("taxi_ranks")
}

model TaxiOnRoute {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  taxi      Taxi     @relation(fields: [taxiId], references: [id], onDelete: Cascade)
  taxiId    String
  route     Route    @relation(fields: [routeId], references: [id], onDelete: Cascade)
  routeId   String
  isActive  Boolean  @default(true)

  @@unique([taxiId, routeId])
  @@map("taxi_routes")
}

// TRIP MODELS
model Trip {
  id             String        @id @default(uuid())
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  user           User          @relation(fields: [userId], references: [id])
  userId         String
  taxi           Taxi          @relation(fields: [taxiId], references: [id])
  taxiId         String
  route          Route         @relation(fields: [routeId], references: [id])
  routeId        String
  rank           Rank          @relation(fields: [rankId], references: [id])
  rankId         String
  pickupAddress  String
  pickupLat      Float
  pickupLng      Float
  dropoffAddress String
  dropoffLat     Float
  dropoffLng     Float
  fare           Decimal       @db.Decimal(10, 2)
  status         TripStatus    @default(REQUESTED)
  paymentMethod  PaymentMethod @default(CASH)
  paymentStatus  PaymentStatus @default(PENDING)
  requestTime    DateTime      @default(now())
  acceptTime     DateTime?
  pickupTime     DateTime?
  dropoffTime    DateTime?
  cancelReason   String?
  rating         TripRating?
  events         TripEvent[]

  @@map("trips")
}

model TripRating {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  trip        Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripId      String   @unique
  user        User     @relation(fields: [userId], references: [id])
  userId      String
  driver      Driver   @relation(fields: [driverId], references: [id])
  driverId    String
  rating      Int // 1-5 stars
  comment     String?
  cleanliness Int? // Additional rating criteria
  safety      Int? // Additional rating criteria
  timeliness  Int? // Additional rating criteria

  @@map("trip_ratings")
}

model TripEvent {
  id        String        @id @default(uuid())
  createdAt DateTime      @default(now())
  trip      Trip          @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripId    String
  type      TripEventType
  timestamp DateTime      @default(now())
  lat       Float?
  lng       Float?
  data      Json? // Additional event data

  @@map("trip_events")
}

// REPORTS AND SUPPORT
model Report {
  id              String       @id @default(uuid())
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  type            ReportType
  description     String
  status          ReportStatus @default(OPEN)
  taxiId          String?
  driverId        String?
  reporterId      String // User ID of reporter
  assignedTo      String? // Admin/staff ID
  images          String[] // URLs to uploaded images
  resolutionNotes String?
  closedAt        DateTime?

  @@map("reports")
}

model SupportTicket {
  id         String           @id @default(uuid())
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  subject    String
  message    String
  status     TicketStatus     @default(OPEN)
  userId     String
  assignedTo String? // Admin/staff ID
  messages   SupportMessage[]

  @@map("support_tickets")
}

model SupportMessage {
  id        String        @id @default(uuid())
  createdAt DateTime      @default(now())
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId  String
  message   String
  sender    String // "user" or "staff"
  readAt    DateTime?

  @@map("support_messages")
}

// ENUMS
enum DriverStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum TaxiStatus {
  AVAILABLE
  BUSY
  OFFLINE
  MAINTENANCE
}

enum RouteStatus {
  ACTIVE
  BUSY
  INACTIVE
}

enum TripStatus {
  REQUESTED
  ACCEPTED
  ARRIVED_AT_PICKUP
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  QR_CODE
  MOBILE_MONEY
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum TripEventType {
  REQUEST_CREATED
  DRIVER_ASSIGNED
  DRIVER_ARRIVED
  TRIP_STARTED
  ROUTE_UPDATED
  TRIP_COMPLETED
  TRIP_CANCELLED
  PAYMENT_COMPLETED
}

enum ReportType {
  DRIVER_BEHAVIOR
  VEHICLE_CONDITION
  ROUTE_DEVIATION
  OVERCHARGING
  SAFETY_CONCERN
  OTHER
}

enum ReportStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  CLOSED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}
